# ============================================================
# Threads自動運用AI - 環境変数設定
# このファイルを .env にコピーして値を入力してください
# cp .env.example .env
# ============================================================

# --- Google Gemini API ---
# https://aistudio.google.com/app/apikey で無料取得
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Meta / Threads API ---
# Meta for Developers (https://developers.facebook.com) で取得
# Threads API アクセスには Instagram アカウントが必要
THREADS_USER_ID=1234567890
THREADS_ACCESS_TOKEN=EAAxxxxxxxxxx

# --- 運用設定 ---
# 1日に投稿する回数
POSTS_PER_DAY=3

# 投稿のトーン: casual(カジュアル) / professional(プロ) / humorous(ユーモア)
POST_TONE=casual

# アカウントのテーマ（何について投稿するか）
# 例: "ライフハック,テクノロジー,日常の気づき"
POST_TOPICS=ライフハック,テクノロジー,日常の気づき

# 投稿言語
POST_LANGUAGE=Japanese

# タイムゾーン
TIMEZONE=Asia/Tokyo

# --- X (Twitter) API ---
# https://developer.twitter.com/en/portal/dashboard でアプリを作成して取得
# ※ 4つすべて設定した場合のみ X への自動投稿が有効になります
# ※ 空白のままにすると Threads のみ投稿されます
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Billia ---
# 投稿後リプライで自動添付するURL（クラファンページ、LP等）。空にすると無効。
BILLIA_URL=https://camp-fire.jp/projects/billia
