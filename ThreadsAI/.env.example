# ============================================================
# Threads自動運用AI - 環境変数設定
# このファイルを .env にコピーして値を入力してください
# cp .env.example .env
# ============================================================

# --- Anthropic (Claude API) ---
# https://console.anthropic.com でAPIキーを取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# --- Meta / Threads API ---
# Meta for Developers (https://developers.facebook.com) で取得
# Threads API アクセスには Instagram アカウントが必要
THREADS_USER_ID=1234567890
THREADS_ACCESS_TOKEN=EAAxxxxxxxxxx

# --- 運用設定 ---
# 1日に投稿する回数
POSTS_PER_DAY=3

# 投稿のトーン: casual(カジュアル) / professional(プロ) / humorous(ユーモア)
POST_TONE=casual

# アカウントのテーマ（何について投稿するか）
# 例: "ライフハック,テクノロジー,日常の気づき"
POST_TOPICS=ライフハック,テクノロジー,日常の気づき

# 投稿言語
POST_LANGUAGE=Japanese

# タイムゾーン
TIMEZONE=Asia/Tokyo
